[global_config]
  inactive_color_offset = 0.7
[keybindings]
  go_next = <Alt>n
  go_prev = <Alt>p
  go_up = <Alt>K
  go_down = <Alt>J
  go_left = <Alt>H
  go_right = <Alt>L
  split_horiz = <Alt>minus
  split_vert = <Alt>backslash
  move_tab_right = <Primary><Shift>n
  move_tab_left = <Primary><Shift>p
  layout_launcher = <Shift><Alt>l
[profiles]
  [[default]]
    background_image = None
    cursor_blink = False
    font = DejaVu Sans Mono 15
    foreground_color = "#888888"
    use_system_font = False
  [[Presentation]]
    background_image = None
    use_theme_colors = True
  [[Scratchpad]]
    background_darkness = 0.82
    background_type = transparent
    background_image = None
[layouts]
  [[default]]
    [[[child1]]]
      parent = window0
      profile = default
      type = Terminal
    [[[window0]]]
      parent = ""
      type = Window
[plugins]
